{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$|^Bash$",
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/worktree-guard.cjs\"", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/pool-session.cjs\"", "timeout": 5 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/pool-session.cjs\"", "timeout": 2 }
        ]
      }
    ]
  }
}
